# ---------- Initialize Simulation ---------------------
clear
units metal
dimension 3
boundary p p s
atom_style atomic
atom_modify map array

# ---------- Create Atoms & Regions ---------------------
read_data ../EdgeRelaxation/EdgeRelaxed.lmp

region bottom block EDGE EDGE EDGE EDGE EDGE 5 units box
region top block EDGE EDGE EDGE EDGE 68 EDGE units box

group top region top
group bottom region bottom

# ---------- Dynamic Area and Atom Counts ---------------------
# Calculates the live cross-sectional area (Lx * Ly)
variable Area equal lx*ly

# Automatically counts the number of atoms currently in each group
variable Ntop equal count(top)
variable Nbot equal count(bottom)

# ---------- Force Calculations ---------------------
variable sigxy equal ${stress}

# 1. Total force is stress multiplied by the dynamic Area variable
variable force equal ${sigxy}*v_Area

# 2. Convert force to your target units using your conversion factor
variable forcexunits equal ${force}*(6.2415e-6)

# 3. Divide the total converted force by the live atom count of each group
variable forcetop equal ${forcexunits}/v_Ntop
variable forcebot equal ${forcexunits}/v_Nbot

fix forcetop top addforce  0.0 ${forcetop} 0.0 
fix forcebottom bottom addforce  0.0 -${forcebot} 0.0 

fix_modify forcetop energy yes
fix_modify forcebottom energy yes

mass 1 180.9479  # Atomic mass of Ta
mass 2 12.011    # Atomic mass of C


# ---------- Define Interatomic Potential --------------------- 

pair_style hybrid/overlay zbl 4.0 4.2 snap
pair_coeff 1 1 zbl 73 73
pair_coeff 1 2 zbl 73 6
pair_coeff 2 2 zbl 6 6
pair_coeff * * snap ../TaC_pot.snapcoeff ../TaC_pot.snapparam Ta C


compute        peratom all pe/atom


thermo 1 
thermo_style custom step pe lx ly lz press pxy pyy pzz cellalpha cellbeta cellgamma
min_style fire
minimize 0 1e-2 10000 10000


reset_timestep 0

fix extra all print 1 """
- stress: ${sigxy}
  energy: $(pe)
""" append energy.yaml screen no title ""

run 0
