[BISPECTRUM]
numTypes = 2
twojmax = 6 6
rcutfac = 1.0
rfac0 = 0.99363
rmin0 = 0.0
wj = 1.0 0.9293160905266721
radelem = 2.86954 2.00000
type = Ta C
wselfallflag = 1
chemflag = 1
bnormflag = 1
quadraticflag = 0
bzeroflag = 1

[CALCULATOR]
calculator = LAMMPSSNAP
energy = 1
force = 1
stress = 0

[ESHIFT]
Ta = 3.44766
C = 1.24304

[SOLVER]
solver = SVD
compute_testerrs = 1
detailed_errors = 1

[SCRAPER]
scraper = JSON

[PATH]
dataPath = JSON

[OUTFILE]
metrics = TaC_metrics.md
potential = TaC_pot

[REFERENCE]
units = metal
atom_style = atomic
pair_style = hybrid/overlay zero 7.01 zbl 4.0 4.2
pair_coeff1 = * * zero
pair_coeff2 = 1 1 zbl 73 73
pair_coeff3 = 1 2 zbl 73 6
pair_coeff4 = 2 2 zbl 6 6


[GROUPS]
group_sections = name training_size testing_size eweight fweight vweight
group_types = str float float float float float
smartweights = 1
random_sampling = 0
TaC_Volume        =   1  0    0.67078     1e-8     1.00E-08
Carbon            =   1  0    1.00000     1e-8     1.00E-08
C_FCC             =   1  0    0.64983     1e-8     1.00E-08
C_BCC             =   1  0    0.68859     1e-8     1.00E-08
WC                =   1  0    1.00000     1e-8     1.00E-08 
NiAs              =   1  0    0.48255     1e-8     1.00E-08 
CsCl              =   1  0    0.29126     1e-8     1.00E-08 
ZincBlende        =   1  0    0.75878     1e-8     1.00E-08 
Vacancies         =   1  0    0.53084     0.69712        1.00E-08 #need to up the force weights on this group
Ta                =   1  0    0.52294     1e-8     1.00E-08
Ta_Isolated       =   1  0    1     1e-8     1.00E-08
C_Isolated        =   1  0    1     1e-8     1.00E-08
EOS_copy          =   1  0    0.40530     1e-8     1.00E-08
OtherStructures   =   1  0    0.38667     0.50329        1.00E-08
TaC_MD            =   1  0    0.94458     0.72227       1.00E-08
GammaMD            =   1  0    0.76797     0.61209       1.00E-08
GammaSurf            =   1  0    0.63605    0.48574       1.00E-08
EdgeMD            =   1  0    0.47543     1.00000       1.00E-08
GSF_111_112       =   1  0    0.61136     0.49705       1.00E-08
GSF_111_110       =   1  0    0.38187     0.45182       1.00E-08
GSF_110_110       =   1  0    0.61378     1.00000       1.00E-08
TaC_Surfaces      =   1  0    0.36213     0.49521       1.00E-08
TaC_Liquidcopy    =   1  0    0.28984     1.00000       1.00E-08
Defects           =   1  0    0.30319     0.89149       1.00E-08

[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0

[MEMORY]
override = 0