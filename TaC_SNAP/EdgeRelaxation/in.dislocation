units metal
dimension 3
atom_style atomic
variable a equal 2
boundary p p s
lattice fcc ${a} origin 0.001 0.001 0.001 orient x 1 1 -2 orient y 1 -1 0 orient z -1 -1 -1
region simcell block 0 3 0 24 -0.5 10
region top block 0 3 0 23.5 5 10
region bottom block 0 3 0 24 -0.5 5
create_box 2 simcell
create_atoms 1 region bottom
lattice fcc ${a} origin 0.001 0.001 0.501 orient x 1 1 -2 orient y 1 -1 0 orient z -1 -1 -1 
create_atoms 2 region bottom
lattice fcc ${a}  origin 0.001 0.001 0.001 orient x 1 1 -2 orient y 1 -1 0 orient z -1 -1 -1
create_atoms 1 region top
lattice fcc ${a} origin 0.001 0.001 0.501 orient x 1 1 -2 orient y 1 -1 0 orient z -1 -1 -1
create_atoms 2 region top

mass 1 180.9479  # Atomic mass of Ta
mass 2 12.011    # Atomic mass of C

write_data Unrelaxed.lmp

group top region top
group bottom region bottom

displace_atoms top ramp y 0.0 0.5 y 0 23.5 units lattice


pair_style hybrid/overlay zbl 4.0 4.2 snap
pair_coeff 1 1 zbl 73 73
pair_coeff 1 2 zbl 73 6
pair_coeff 2 2 zbl 6 6
pair_coeff * * snap ../TaC_pot.snapcoeff ../TaC_pot.snapparam Ta C



thermo 1
thermo_style custom step pe pxx pyy pzz pxy pyz pxz lx ly lz xy yz xz
variable P equal press
variable V equal vol
variable Sxy equal pxy
variable Syy equal pyy
variable Szz equal pzz
variable Lx equal lx
variable Ly equal ly
variable Lz equal lz
variable E equal pe
variable N equal atoms


min_style cg

minimize 0 1e-5 10000 10000

write_data EdgeRelaxed.lmp

