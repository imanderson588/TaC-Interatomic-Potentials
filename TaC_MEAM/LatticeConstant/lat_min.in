# Find minimum energy fcc configuration
# Mark Tschopp, 2010

# ---------- Initialize Simulation --------------------- 
clear 
units metal 
dimension 3 
boundary p p p 
atom_style atomic 
atom_modify map array
variable a equal 5.0

# ---------- Create Atoms --------------------- 

lattice         fcc $a 
region          box block 0 4 0 4 0 4
create_box      2 box
create_atoms    1 box
lattice         fcc $a origin 0.50000000 0.50000000 0.50000000
create_atoms    2 box

mass 1 180.9479  # Atomic mass of Ta
mass 2 12.011    # Atomic mass of C


# ---------- Define Interatomic Potential --------------------- 
pair_style meam
pair_coeff * * ../library.meam Ta C ../TaC.meam Ta C
 
# ---------- Define Settings --------------------- 
compute eng all pe/atom 
compute eatoms all reduce sum c_eng 
thermo 10

# ---------- Run Minimization --------------------- 
reset_timestep 0 
fix 1 all box/relax iso 0.0 vmax .001
thermo 10 
thermo_style custom step pe lx ly lz press pxx pyy pzz c_eatoms 
min_style cg
minimize 1e-12 1e-12 50000 100000

variable natoms equal "count(all)" 
variable teng equal "c_eatoms"
variable length equal "lx/4"
variable ecoh equal "v_teng/256"

print "Total energy (eV) = ${teng};"
print "Number of atoms = ${natoms};"
print "Lattice constant (Angstoms) = ${length};"
print "Cohesive energy (eV) = ${ecoh};"


print "All done!"
